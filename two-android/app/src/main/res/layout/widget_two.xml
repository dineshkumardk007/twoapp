<?xml version="1.0" encoding="utf-8"?>
<!--
  The moon widget: one picture (SkyArt draws tonight's moon, the stars and
  the date at the widget's real size). The whole of it opens Two. Until the
  first picture is drawn, the still preview stands in.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_description"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sky_preview" />
</FrameLayout>
