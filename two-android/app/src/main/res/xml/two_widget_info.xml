<?xml version="1.0" encoding="utf-8"?>
<!--
  The moon widget: four cells by two, resizable down to a two-by-two square
  (SkyArt draws a stacked picture for that). Redrawn whenever a message comes
  or is read, and every 30 minutes by the launcher, so the moon and the date
  move on even when Two has not been opened.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_two"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_sky_preview"
    android:previewLayout="@layout/widget_two_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
