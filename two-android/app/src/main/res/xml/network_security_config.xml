<?xml version="1.0" encoding="utf-8"?>
<!--
  No plaintext, anywhere. The page is served from the secure origin
  https://appassets.androidplatform.net, the relay is wss://, and live radio
  only plays https streams.

  A debug build adds exceptions for a relay running on the developer's own
  machine (src/debug/res/xml/network_security_config.xml); the release app
  used to carry those too, which let it talk in plaintext to whatever answered
  on localhost or on that one home-network address.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
