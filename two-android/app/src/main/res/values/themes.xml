<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Two" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/aurora_night</item>
        <item name="android:navigationBarColor">@color/aurora_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- The window behind everything, seen for a moment before the page
             first draws: the night sky, so the launch screen, the window and
             the app are one colour with no flash between them. -->
        <item name="android:windowBackground">@color/aurora_night</item>
    </style>

    <!--
      The launch screen: the app icon's two circles on the Aurora night sky.

      MainActivity starts in this theme. installSplashScreen() moves the
      activity on to Theme.Two (postSplashScreenTheme) straight away, but the
      mark stays drawn over it until the page has drawn its first real screen,
      so opening the app goes from the mark to the app with no blank
      page in between. On Android 12 and later this is the system's own
      launch screen; on 8 to 11 the splash-screen library draws the same
      thing.

      The icon is the adaptive icon's foreground layer, which is drawn for
      exactly this kind of circular crop: the circles sit inside its safe
      circle, so nothing is clipped.
    -->
    <style name="Theme.Two.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aurora_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/aurora_icon_back</item>
        <item name="postSplashScreenTheme">@style/Theme.Two</item>
        <!-- Light clock and battery icons over the night sky. -->
        <item name="android:statusBarColor">@color/aurora_night</item>
        <item name="android:navigationBarColor">@color/aurora_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      The widget's pop-up: no window of its own to speak of. It draws its own
      dimmed backdrop and card over whatever is behind it - the home screen.
    -->
    <style name="Theme.Two.Popup" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
