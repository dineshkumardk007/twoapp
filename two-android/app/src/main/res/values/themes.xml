<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Two" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/linen_background</item>
        <item name="android:navigationBarColor">@color/linen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- The window behind everything, seen for a moment before the page
             first draws. The Material default here is a cold white, which
             showed as a flash between the cream launch screen and the cream
             app. -->
        <item name="android:windowBackground">@color/linen_background</item>
    </style>

    <!--
      The launch screen: the leaf from the app icon on the linen background.

      MainActivity starts in this theme. installSplashScreen() moves the
      activity on to Theme.Two (postSplashScreenTheme) straight away, but the
      leaf stays drawn over it until the page has drawn its first real screen,
      so opening the app goes from the leaf to the app with no blank cream
      page in between. On Android 12 and later this is the system's own
      launch screen; on 8 to 11 the splash-screen library draws the same
      thing.

      The icon is the adaptive icon's foreground layer, which is drawn for
      exactly this kind of circular crop: the leaves sit inside its safe
      circle, so nothing is clipped.
    -->
    <style name="Theme.Two.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/linen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Two</item>
        <!-- Dark clock and battery icons over the linen, even when the phone
             itself is in dark mode. -->
        <item name="android:statusBarColor">@color/linen_background</item>
        <item name="android:navigationBarColor">@color/linen_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
