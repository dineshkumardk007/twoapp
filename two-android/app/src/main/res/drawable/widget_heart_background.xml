<?xml version="1.0" encoding="utf-8"?>
<!-- The heart's button: Two's pink to peach, with a fine edge of light along the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#FB923C"
                android:startColor="#EC4899"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
