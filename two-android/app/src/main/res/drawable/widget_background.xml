<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: the app's night sky, a faint edge of light. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:centerColor="#1A1238"
        android:endColor="#0E0B1F"
        android:startColor="#2A1D5C"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
