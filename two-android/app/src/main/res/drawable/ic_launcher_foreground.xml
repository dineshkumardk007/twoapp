<?xml version="1.0" encoding="utf-8"?>
<!--
  The app mark: two circles, one for each of you, and the bright space where
  they overlap - the space this app is. Violet and pink-to-peach, the
  aurora's colours; the overlap lit nearly white.

  Drawn as a vector so it is sharp from the 48dp launcher grid to the 512dp
  store listing. Kept well inside the 66dp safe circle, so a round, squircle
  or teardrop mask clips nothing - and the launch screen shows it whole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- One of you -->
    <path android:pathData="M26,54a18,18 0,1 0,36 0a18,18 0,1 0,-36 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26"
                android:startY="36"
                android:endX="62"
                android:endY="72">
                <item android:offset="0" android:color="#FFC4B5FD" />
                <item android:offset="1" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The other -->
    <path android:pathData="M46,54a18,18 0,1 0,36 0a18,18 0,1 0,-36 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="36"
                android:endX="82"
                android:endY="72">
                <item android:offset="0" android:color="#FFF472B6" />
                <item android:offset="1" android:color="#FFFB923C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- What you share -->
    <path android:pathData="M54,39.03A18,18 0,0 1,54 68.97A18,18 0,0 1,54 39.03z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="39"
                android:endX="54"
                android:endY="69">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFFFE4F1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
