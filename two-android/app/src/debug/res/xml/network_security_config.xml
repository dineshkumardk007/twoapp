<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (this file replaces the main one in a debug build).

  Plaintext is refused everywhere except a relay running on this desk.
  NetworkConfig.wsRelayUrl yields ws:// when the relay is pointed at a local
  address, so without these, testing against a relay on this machine would
  quietly fail - a socket that never opens, with nothing on screen to say why.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <!-- How an emulator reaches the host machine. -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- NetworkConfig.PHYSICAL_DEVICE_HOST, for a phone on the same Wi-Fi. -->
        <domain includeSubdomains="true">192.168.29.197</domain>
    </domain-config>
</network-security-config>
